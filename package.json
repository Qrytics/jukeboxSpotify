{
	"name": "jukebox",
	"productName": "Jukebox",
	"version": "1.0.0",
	"description": "A Minecraft-style jukebox mini-player that opens by itself when Spotify does.",
	"private": true,
	"type": "module",
	"main": "electron/main.mjs",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:mock": "JUKEBOX_MOCK=1 node scripts/dev.mjs",
		"build": "vite build",
		"start": "npm run build && electron .",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"icons": "node scripts/make-icons.mjs",
		"dist:mac": "npm run build && electron-builder --mac",
		"dist:win": "npm run build && electron-builder --win"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@fontsource-variable/pixelify-sans": "^5.2.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"build": {
		"appId": "com.qrytics.jukebox",
		"productName": "Jukebox",
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"electron/**",
			"dist/renderer/**",
			"package.json"
		],
		"icon": "build/icon.png",
		"mac": {
			"category": "public.app-category.music",
			"icon": "build/icon.png",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64",
						"x64"
					]
				}
			],
			"extendInfo": {
				"LSUIElement": true,
				"NSAppleEventsUsageDescription": "Jukebox reads what Spotify is playing and sends it play, pause and skip commands."
			}
		},
		"dmg": {
			"artifactName": "Jukebox-${arch}.${ext}"
		},
		"win": {
			"icon": "build/icon.png",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"runAfterFinish": true,
			"shortcutName": "Jukebox",
			"artifactName": "Jukebox-Setup.${ext}"
		}
	}
}
